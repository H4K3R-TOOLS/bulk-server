# Gallery Eye Bulk Server Environment Variables
# Copy this to .env and fill in your values

# Cloudflare R2 (same as main backend)
R2_ACCOUNT_ID=your_account_id
R2_BUCKET_NAME=gallery
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key

# Email (same as main backend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=your_email@gmail.com

# Main Backend URL (for webhooks)
MAIN_BACKEND_URL=https://backend-api-gallery.onrender.com

# Shared secret for inter-service auth
SERVICE_SECRET=your_shared_secret_here

# Server Port
PORT=3002
